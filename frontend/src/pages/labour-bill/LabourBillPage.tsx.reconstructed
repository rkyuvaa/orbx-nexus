              <div class="signature-label">Supplier Signature</div>
            </div>
            <div class="signature-block">
              <div class="signature-line"></div>
              <div class="signature-label">Authorized Signatory for ${cName}</div>
            </div>
          </div>
          <div class="thank-you-note">Thank you for your business!</div>
          <script>
            window.onload = function() {
              window.print();
              setTimeout(function() { window.close(); }, 500);
            };
          </script>
        </body>
      </html>
    `);
    printWindow.document.close();
  };

  const colDefs: ColDef[] = [
    { field: "bill_no", headerName: "Bill No.", width: 120 },
    { field: "bill_date", headerName: "Date", width: 100 },
    { field: "ledger_id", headerName: "Supplier", width: 160, valueGetter: (p) => ledgerMap[p.data?.ledger_id] || p.data?.ledger_id || "" },
    { field: "quantity", headerName: "Qty", width: 70, type: "numericColumn" },
    { field: "rate", headerName: "Rate", width: 80, type: "numericColumn" },
    { field: "amount", headerName: "Amount", width: 100, type: "numericColumn", valueFormatter: (p) => `₹${formatAmount(p.value)}` },
    { field: "gst_percent", headerName: "GST%", width: 75 },
    { field: "total_amount", headerName: "Total", width: 110, type: "numericColumn", valueFormatter: (p) => `₹${formatAmount(p.value)}` },
    { field: "is_paid", headerName: "Status", width: 100,
